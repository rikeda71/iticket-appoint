{
  "name": "iticket-appoint",
  "version": "0.1.0",
  "private": true,
  "description": "アイチケット広場の予約を事前設定のプロファイルで自動化する CLI",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
