    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.64.0",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
